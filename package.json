{
  "name": "mathgame",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fubar83/matteaventyret"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "trainer": "vite --open /trainer.html",
    "mathinput": "vite --open /mathinput.html",
    "mathinput:add": "vite --open /mathinput.html?mall=add",
    "mathinput:sub": "vite --open /mathinput.html?mall=sub",
    "mathinput:mul": "vite --open /mathinput.html?mall=mul",
    "mathinput:shortdiv": "vite --open /mathinput.html?mall=shortDiv",
    "mathinput:trappan": "vite --open /mathinput.html?mall=trappan",
    "detect": "vite --open /detect.html",
    "mathwriting:process": "node scripts/processMathWriting.mjs",
    "emnist:process": "node scripts/processEmnist.mjs",
    "hasy:process": "node scripts/processHasy.mjs",
    "strokes:process": "node scripts/processStrokeTemplates.mjs",
    "mathwriting:extract": "jiti scripts/ts/extractMathWriting.ts",
    "context:extract": "jiti scripts/ts/extractContext.ts",
    "own:import": "node scripts/importOwnSamples.mjs",
    "benchmark": "jiti scripts/ts/benchmark.ts",
    "benchmark:profiles": "jiti scripts/ts/benchmarkProfiles.ts",
    "benchmark:kids": "jiti scripts/ts/benchmarkKids.ts",
    "benchmark:segmentation": "jiti scripts/ts/benchmarkSegmentation.ts",
    "benchmark:order": "jiti scripts/ts/benchmarkOrder.ts",
    "benchmark:errors": "jiti scripts/ts/errorBreakdown.ts",
    "segmenter:align": "jiti scripts/ts/alignStrokes.ts",
    "segmenter:train": "node scripts/trainSegmenter.mjs",
    "checker:train": "node scripts/trainSymbolChecker.mjs",
    "model:train:basic": "node scripts/trainBootstrapModel.mjs --model basic",
    "model:train:full": "node scripts/trainBootstrapModel.mjs --model full",
    "model:train:strokes": "node scripts/trainStrokeModel.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "kenney": "node scripts/kenney/build.mjs"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tensorflow/tfjs": "^4.22.0",
    "gsap": "^3.15.0",
    "howler": "^2.2.4",
    "katex": "^0.18.9",
    "mathlive": "^0.110.0",
    "perfect-freehand": "^1.2.3",
    "pixi.js": "^8.21.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.1",
    "@types/howler": "^2.2.13",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "pngjs": "^7.0.0",
    "storybook": "^10.6.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  }
}
